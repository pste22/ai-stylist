GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model
# STYLIST_MODEL=llama-3.3-70b-versatile

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# ── Rainforest API (recommended — works immediately, free trial = 100 req) ────
# Sign up at https://www.rainforestapi.com/ → copy your API key here
# Free trial gives ~1 000 products. Starter plan $15/mo for ongoing use.
RAINFOREST_API_KEY=your_rainforest_api_key

# ── Amazon Associates ──────────────────────────────────────────────────────────
# Your affiliate tag (already earning commissions on every Shop click)
AMAZON_PARTNER_TAG=21112112-20

# PA-API credentials — needed to fetch real product data + real images
# Get them in 3 steps:
#   1. Go to https://associates.amazon.com
#   2. Top menu → Tools → Product Advertising API → Manage your credentials
#   3. Click "Add credentials" and copy both values below
#
# Note: PA-API access requires 3+ qualifying sales in the last 180 days,
#       OR an approved application for new sites.
AMAZON_ACCESS_KEY=your-pa-api-access-key-id
AMAZON_SECRET_KEY=your-pa-api-secret-key
